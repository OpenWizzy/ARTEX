[Unit]
Description=ARTEX static frontend and API reverse proxy
Wants=network-online.target
After=network-online.target artex.service

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=__CADDY_BIN__ run --config /etc/artex/web/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
